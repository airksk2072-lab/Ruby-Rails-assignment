<h1>スケジュール編集</h1>

<%= form_with model: @schedule, local: true do |f| %>
  <div>
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :start_date, "開始日" %>
    <%= f.date_field :start_date %>
  </div>

  <div>
    <%= f.label :end_date, "終了日" %>
    <%= f.date_field :end_date %>
  </div>

  <div>
    <%= f.label :is_all_day, "終日" %>
    <%= f.check_box :is_all_day %>
  </div>

  <div>
    <%= f.label :note, "スケジュールメモ" %>
    <%= f.text_area :note %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<%= link_to "詳細に戻る", schedule_path(@schedule) %>